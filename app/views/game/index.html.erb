<main class="game-shell">
  <header class="game-header">
    <div>
      <p class="eyebrow">NÆSTEN-LUSK</p>
      <h1>Motorvejen</h1>
    </div>
    <div class="score-card" aria-live="polite">
      <span id="scoreLabel">Distance</span>
      <strong id="score">0 m</strong>
    </div>
  </header>

  <section class="game-stage" id="gameStage" aria-label="Bilspil">
    <canvas id="gameCanvas" width="360" height="640"></canvas>
    <div class="record-holder" id="recordHolder">
      <span>Rekordholder</span>
      <strong id="recordHolderName">Ukendt</strong>
      <small id="recordHolderScore">0 m</small>
    </div>
    <div class="record-popup" id="recordPopup" role="status" aria-live="assertive" hidden>
      <span id="recordMessage">Fedt kørt!</span>
      <strong id="recordDistance">Ny rekord: 0 m</strong>
      <small>— siger Seb</small>
    </div>

    <div class="start-screen" id="startScreen">
      <div class="start-card">
        <div class="mini-car" aria-hidden="true"></div>
        <p class="eyebrow">KLAR PÅ MOTORVEJEN?</p>
        <h2>Undvig trafikken</h2>
        <p>Svup eller brug pilene. Tryk på BÅT for at skubbe biler væk.</p>
        <label class="player-name">
          Dit navn
          <input type="text" id="playerName" maxlength="20" autocomplete="nickname" placeholder="Skriv dit navn">
        </label>
        <fieldset class="color-picker">
          <legend>Vælg bilfarve</legend>
          <label>
            <input type="radio" name="carColor" value="#3dc9b6" checked>
            <span class="color-swatch teal" title="Turkis"></span>
          </label>
          <label>
            <input type="radio" name="carColor" value="#ffb84d">
            <span class="color-swatch orange" title="Orange"></span>
          </label>
          <label>
            <input type="radio" name="carColor" value="#ee5d54">
            <span class="color-swatch red" title="Rød"></span>
          </label>
          <label>
            <input type="radio" name="carColor" value="#9d86e6">
            <span class="color-swatch purple" title="Lilla"></span>
          </label>
          <label>
            <input type="radio" name="carColor" value="#f2a93b">
            <span class="color-swatch yellow" title="Gul"></span>
          </label>
        </fieldset>
        <button type="button" id="startButton">Kør nu</button>
      </div>
    </div>

    <div class="game-over" id="gameOver" hidden>
      <div class="start-card">
        <p class="eyebrow">Trafikulykke</p>
        <h2 id="finalScore">0 meter</h2>
        <button type="button" id="restartButton">Prøv igen</button>
      </div>
    </div>
  </section>

  <nav class="controls" aria-label="Styrebil">
    <button type="button" id="leftButton" aria-label="Kør til venstre">←</button>
    <button type="button" id="hornButton" class="horn-button" aria-label="Brug båthornet">
      <span aria-hidden="true">📣</span> BÅT!
    </button>
    <button type="button" id="rightButton" aria-label="Kør til højre">→</button>
  </nav>
</main>

<script>
  (() => {
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");
    const stage = document.getElementById("gameStage");
    const startScreen = document.getElementById("startScreen");
    const gameOverScreen = document.getElementById("gameOver");
    const scoreElement = document.getElementById("score");
    const scoreLabel = document.getElementById("scoreLabel");
    const finalScore = document.getElementById("finalScore");
    const playerNameInput = document.getElementById("playerName");
    const recordHolderName = document.getElementById("recordHolderName");
    const recordHolderScore = document.getElementById("recordHolderScore");
    const recordPopup = document.getElementById("recordPopup");
    const recordMessage = document.getElementById("recordMessage");
    const recordDistance = document.getElementById("recordDistance");

    const lanes = [78, 180, 282];
    let lane = 1;
    let enemies = [];
    let running = false;
    let score = 0;
    let roadOffset = 0;
    let lastTime = 0;
    let spawnTimer = 0;
    let touchStartX = null;
    let playerY = 510;
    let verticalDirection = 0;
    const verticalKeys = new Set();
    let gyroVerticalDirection = 0;
    let gyroBaselineBeta = null;
    let gyroBaselineGamma = null;
    let gyroLaneDirection = 0;
    let audioContext;

    const player = { width: 52, height: 92 };
    let playerColor = "#3dc9b6";
    let playerX = lanes[1];
    let laneSteering = 0;
    let laneChangeProgress = 1;
    let easterEggImmune = false;
    let lastShakeTime = 0;
    let roadTurns = [];
    let roadGeneratedUntil = 0;

    function ensureRoadTurns(distance) {
      while (roadGeneratedUntil < distance) {
        roadGeneratedUntil += 50 + Math.random() * 110;
        const uTurn = Math.random() < 0.12;
        const length = uTurn ? 170 + Math.random() * 90 : 300 + Math.random() * 400;
        roadTurns.push({
          start: roadGeneratedUntil,
          end: roadGeneratedUntil + length,
          direction: Math.random() < 0.5 ? -1 : 1,
          amplitude: uTurn ? 42 + Math.random() * 10 : 24 + Math.random() * 10
        });
        roadGeneratedUntil += length;
      }
    }

    function roadCurve(y) {
      const distance = score + (510 - y) * 0.3;
      ensureRoadTurns(distance + 500);

      for (const turn of roadTurns) {
        if (distance < turn.start) return 0;
        if (distance <= turn.end) {
          const progress = (distance - turn.start) / (turn.end - turn.start);
          return turn.direction * turn.amplitude * (1 - Math.cos(progress * Math.PI * 2)) / 2;
        }
      }
      return 0;
    }

    function laneX(laneIndex, y) {
      return lanes[laneIndex] + roadCurve(y);
    }
    const profileKey = "det-blaa-lyn-player";
    const recordMessages = [
      "Fedt kørt!",
      "Hold da op, den fløj!",
      "Seb bliver slet ikke overrasket!",
      "Ny afstand! Ingen småt!",
      "Den bil har mere fart end en snegl i ferie!",
      "Motorvejen må hellere give tiebreak!",
      "Hvem lærte den bil at svæve?",
      "Rekordalarm! Hils på benene!",
      "Det var næsten ulovligt godt!",
      "Seb har mistet stemmen af begejstring!"
    ];

    function loadProfile() {
      try {
        const profile = JSON.parse(localStorage.getItem(profileKey)) || {};
        const allowedColors = ["#3dc9b6", "#ffb84d", "#ee5d54", "#9d86e6", "#f2a93b"];

        if (typeof profile.name === "string") {
          playerNameInput.value = profile.name.slice(0, 20);
        }
        if (allowedColors.includes(profile.color)) {
          playerColor = profile.color;
          const selected = document.querySelector(`input[name="carColor"][value="${profile.color}"]`);
          if (selected) selected.checked = true;
          document.querySelector(".mini-car").style.background = profile.color;
        }
        if (Number.isFinite(profile.bestScore)) {
          scoreLabel.textContent = `Bedst: ${Math.floor(profile.bestScore)} m`;
          recordHolderScore.textContent = `${Math.floor(profile.bestScore)} m`;
        }
        if (typeof profile.name === "string" && profile.name.trim()) {
          recordHolderName.textContent = profile.name.trim();
        }
      } catch {
        localStorage.removeItem(profileKey);
      }
    }

    function saveProfile() {
      const existing = JSON.parse(localStorage.getItem(profileKey) || "{}");
      const name = playerNameInput.value.trim();
      const currentScore = Math.floor(score);
      const bestScore = Math.max(Number(existing.bestScore) || 0, currentScore);
      localStorage.setItem(profileKey, JSON.stringify({
        name,
        color: playerColor,
        bestScore
      }));
      return { bestScore, previousBest: Number(existing.bestScore) || 0 };
    }

    function drawRoad() {
      ctx.fillStyle = "#26313a";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.beginPath();
      for (let y = 0; y <= canvas.height; y += 8) {
        const x = 24 + roadCurve(y);
        if (y === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      for (let y = canvas.height; y >= 0; y -= 8) {
        ctx.lineTo(336 + roadCurve(y), y);
      }
      ctx.closePath();
      ctx.fillStyle = "#3b464d";
      ctx.fill();

      ctx.strokeStyle = "#f6d365";
      ctx.lineWidth = 5;
      [24, 336].forEach((baseX) => {
        ctx.beginPath();
        for (let y = 0; y <= canvas.height; y += 8) {
          const x = baseX + roadCurve(y);
          if (y === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      });

      ctx.fillStyle = "#eef1e5";
      for (let y = roadOffset - 80; y < canvas.height; y += 80) {
        [127, 229].forEach((baseX) => {
          ctx.fillRect(baseX + roadCurve(y), y, 6, 42);
        });
      }

      ctx.fillStyle = "rgba(255,255,255,.12)";
      [49, 311].forEach((baseX) => {
        ctx.beginPath();
        for (let y = 0; y <= canvas.height; y += 8) {
          const x = baseX + roadCurve(y);
          if (y === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      });
    }

    function roundedRect(x, y, width, height, radius) {
      ctx.beginPath();
      ctx.roundRect(x, y, width, height, radius);
    }

    function drawCar(x, y, color, playerCar = false) {
      ctx.save();
      ctx.translate(x, y);
      ctx.shadowColor = "rgba(0,0,0,.25)";
      ctx.shadowBlur = 8;
      ctx.shadowOffsetY = 5;

      ctx.fillStyle = "#090d10";
      ctx.fillRect(-31, 8, 9, 25);
      ctx.fillRect(22, 8, 9, 25);
      ctx.fillRect(-31, 59, 9, 25);
      ctx.fillRect(22, 59, 9, 25);

      ctx.fillStyle = "#10171c";
      ctx.fillRect(-player.width / 2 - 5, 12, 11, 28);
      ctx.fillRect(player.width / 2 - 6, 12, 11, 28);
      ctx.fillRect(-player.width / 2 - 5, 58, 11, 28);
      ctx.fillRect(player.width / 2 - 6, 58, 11, 28);

      roundedRect(-25, 4, 50, 84, 10);
      ctx.fillStyle = color;
      ctx.fill();

      ctx.fillStyle = "rgba(255,255,255,.18)";
      ctx.fillRect(-20, 8, 40, 5);
      ctx.fillRect(-20, 79, 40, 4);

      roundedRect(-17, 20, 34, 22, 6);
      ctx.fillStyle = "#90bac7";
      ctx.fill();
      ctx.fillRect(-13, 24, 26, 3);

      ctx.fillStyle = "#1a252b";
      ctx.fillRect(-19, 48, 38, 7);

      roundedRect(-17, 57, 34, 16, 5);
      ctx.fillStyle = "#263840";
      ctx.fill();

      ctx.fillStyle = playerCar ? "#fff4aa" : "#ff6659";
      ctx.fillRect(-21, 8, 10, 5);
      ctx.fillRect(11, 8, 10, 5);

      ctx.fillStyle = "#151b1e";
      ctx.fillRect(-28, 0, 56, 5);
      ctx.fillRect(-24, 5, 5, 7);
      ctx.fillRect(19, 5, 5, 7);
      ctx.restore();
    }

    function spawnEnemy() {
      const available = lanes.filter((_, index) => {
        return !enemies.some((enemy) => enemy.lane === index && enemy.y < 180);
      });
      if (!available.length) return;

      const laneIndex = lanes.indexOf(available[Math.floor(Math.random() * available.length)]);
      const colors = ["#ee5d54", "#f2a93b", "#7ec8b8", "#9d86e6", "#d66d9b"];
      enemies.push({
        lane: laneIndex,
        y: -100,
        color: colors[Math.floor(Math.random() * colors.length)],
        pushed: false,
        pushOffset: 0,
        pushDirection: 0
      });
    }

    function reset() {
      saveProfile();
      easterEggImmune = playerNameInput.value.trim() === "LaksenVax";
      canvas.dataset.immune = easterEggImmune ? "true" : "false";
      score = 0;
      roadTurns = [];
      roadGeneratedUntil = 0;
      lane = 1;
      playerY = 510;
      verticalDirection = 0;
      verticalKeys.clear();
      gyroVerticalDirection = 0;
      gyroLaneDirection = 0;
      playerX = laneX(lane, playerY);
      laneSteering = 0;
      laneChangeProgress = 1;
      enemies = [];
      roadOffset = 0;
      spawnTimer = 0;
      lastTime = 0;
      scoreElement.textContent = "0 m";
      gameOverScreen.hidden = true;
      recordPopup.hidden = true;
      startScreen.hidden = true;
      running = true;
      requestAnimationFrame(loop);
    }

    function endGame() {
      running = false;
      const finishedScore = Math.floor(score);
      const { previousBest, bestScore } = saveProfile();
      finalScore.textContent = `${Math.floor(score)} meter`;
      if (finishedScore > previousBest) {
        recordMessage.textContent = recordMessages[
          Math.floor(Math.random() * recordMessages.length)
        ];
        recordDistance.textContent = `Ny rekord: ${bestScore} m`;
        recordPopup.hidden = false;
        scoreLabel.textContent = `Bedst: ${bestScore} m`;
        recordHolderName.textContent = playerNameInput.value.trim() || "Ukendt";
        recordHolderScore.textContent = `${bestScore} m`;
      }
      gameOverScreen.hidden = false;
    }

    function move(direction) {
      if (!running) return;
      const nextLane = Math.max(0, Math.min(lanes.length - 1, lane + direction));
      if (nextLane === lane) return;

      lane = nextLane;
      laneChangeProgress = 0;
      laneSteering = direction;
    }

    function playHorn() {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return;
      audioContext ||= new AudioContextClass();
      if (audioContext.state === "suspended") audioContext.resume();

      const hornStage = Math.floor(score / 500);
      const toneSets = [
        [196, 233],
        [220, 261.63],
        [246.94, 293.66],
        [261.63, 311.13],
        [293.66, 349.23],
        [329.63, 392],
        [349.23, 440]
      ];
      const tones = toneSets[hornStage % toneSets.length];

      const now = audioContext.currentTime;
      const gain = audioContext.createGain();
      const filter = audioContext.createBiquadFilter();
      filter.type = "lowpass";
      filter.frequency.setValueAtTime(1450, now);
      filter.Q.setValueAtTime(1.2, now);

      gain.gain.setValueAtTime(0.001, now);
      gain.gain.exponentialRampToValueAtTime(0.22, now + 0.055);
      gain.gain.setValueAtTime(0.22, now + 0.48);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.72);
      gain.connect(filter);
      filter.connect(audioContext.destination);

      tones.forEach((frequency, index) => {
        const oscillator = audioContext.createOscillator();
        oscillator.type = "sawtooth";
        oscillator.frequency.setValueAtTime(frequency, now);
        oscillator.frequency.linearRampToValueAtTime(frequency - (index ? 4 : 7), now + 0.72);
        oscillator.detune.setValueAtTime(index ? 7 : -7, now);
        oscillator.connect(gain);
        oscillator.start(now);
        oscillator.stop(now + 0.73);
      });
    }

    function honk() {
      if (!running) return;
      playHorn();

      const target = enemies.find((enemy) =>
        !enemy.pushed &&
        enemy.lane === lane &&
        enemy.y < playerY &&
        enemy.y + player.height > playerY - 190
      );

      if (target) {
        target.pushed = true;
        target.pushDirection = target.lane === lanes.length - 1 ? 1 : -1;
      }
    }

    function collision(enemy) {
      if (enemy.pushed) return false;
      if (easterEggImmune) return false;
      const enemyX = laneX(enemy.lane, enemy.y);
      return Math.abs(enemyX - playerX) < 46 &&
        enemy.y + player.height > playerY &&
        enemy.y < playerY + player.height;
    }

    function loop(time) {
      if (!running) return;
      const delta = Math.min((time - lastTime) / 16.67 || 1, 2);
      lastTime = time;

      score += delta * 0.18;
      roadOffset = (roadOffset + delta * 7) % 80;
      spawnTimer += delta;

      if (spawnTimer > Math.max(38, 72 - score * 0.08)) {
        spawnEnemy();
        spawnTimer = 0;
      }

      drawRoad();
      enemies.forEach((enemy) => {
        enemy.y += delta * (4.2 + Math.min(score / 180, 4));
        if (enemy.pushed) enemy.pushOffset += delta * 4.5;
        const x = laneX(enemy.lane, enemy.y) + enemy.pushDirection * enemy.pushOffset;
        drawCar(x, enemy.y, enemy.color);
      });

      enemies = enemies.filter((enemy) =>
        enemy.y < canvas.height + 100 && enemy.pushOffset < 100
      );
      const verticalInput = Math.max(-1, Math.min(1, verticalDirection + gyroVerticalDirection));
      playerY = Math.max(120, Math.min(canvas.height - player.height, playerY + verticalInput * delta * 3.5));

      laneChangeProgress = Math.min(1, laneChangeProgress + delta * 0.055);
      const easedProgress = 1 - Math.pow(1 - laneChangeProgress, 3);
      const targetPlayerX = laneX(lane, playerY);
      playerX += (targetPlayerX - playerX) * (0.12 + easedProgress * 0.12) * delta;

      if (laneChangeProgress >= 1) {
        laneSteering = 0;
        playerX = targetPlayerX;
      }

      ctx.save();
      const sway = laneChangeProgress < 1
        ? Math.sin(laneChangeProgress * Math.PI) * laneSteering * 7
        : 0;
      ctx.translate(playerX, playerY);
      ctx.rotate(sway * Math.PI / 180);
      ctx.translate(-playerX, -playerY);
      drawCar(playerX, playerY, playerColor, true);
      ctx.restore();

      scoreElement.textContent = `${Math.floor(score)} m`;
      if (enemies.some(collision)) {
        endGame();
        return;
      }

      requestAnimationFrame(loop);
    }

    document.getElementById("startButton").addEventListener("click", reset);
    document.getElementById("restartButton").addEventListener("click", reset);
    document.getElementById("leftButton").addEventListener("pointerdown", () => move(-1));
    document.getElementById("rightButton").addEventListener("pointerdown", () => move(1));
    document.getElementById("hornButton").addEventListener("pointerdown", honk);
    document.querySelectorAll('input[name="carColor"]').forEach((input) => {
      input.addEventListener("change", () => {
        playerColor = input.value;
        saveProfile();
        document.querySelector(".mini-car").style.background = playerColor;
        if (!running) {
          drawRoad();
          drawCar(laneX(lane, playerY), playerY, playerColor, true);
        }
      });
    });
    playerNameInput.addEventListener("input", () => {
      saveProfile();
      recordHolderName.textContent = playerNameInput.value.trim() || "Ukendt";
    });

    function breakEasterEgg() {
      if (!easterEggImmune) return;
      easterEggImmune = false;
      canvas.dataset.immune = "false";
      playHorn();
    }

    function toggleEasterEggByShake() {
      if (playerNameInput.value.trim() !== "LaksenVax") return;
      easterEggImmune = !easterEggImmune;
      canvas.dataset.immune = easterEggImmune ? "true" : "false";
      playHorn();
    }

    window.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key.toLowerCase() === "a") move(-1);
      if (event.key === "ArrowRight" || event.key.toLowerCase() === "d") move(1);
      if (event.code === "KeyH" && !event.repeat) honk();
      if (event.code === "KeyL" && !event.repeat) toggleEasterEggByShake();
      if (event.code === "KeyS" && !event.repeat) breakEasterEgg();
      if (event.code === "ArrowUp" || event.code === "ArrowDown") {
        event.preventDefault();
        if (running) {
          verticalKeys.add(event.code);
          verticalDirection = verticalKeys.has("ArrowUp") ? -1 : 1;
        }
      }
    });

    window.addEventListener("keyup", (event) => {
      if (event.code !== "ArrowUp" && event.code !== "ArrowDown") return;
      verticalKeys.delete(event.code);
      verticalDirection = verticalKeys.has("ArrowUp") ? -1 : verticalKeys.has("ArrowDown") ? 1 : 0;
    });

    window.addEventListener("blur", () => {
      verticalKeys.clear();
      verticalDirection = 0;
    });

    window.addEventListener("deviceorientation", (event) => {
      if (event.beta === null || event.gamma === null) return;
      if (gyroBaselineBeta === null || gyroBaselineGamma === null) {
        gyroBaselineBeta = event.beta;
        gyroBaselineGamma = event.gamma;
        return;
      }

      const pitch = event.beta - gyroBaselineBeta;
      const roll = event.gamma - gyroBaselineGamma;
      gyroVerticalDirection = Math.abs(pitch) > 7
        ? Math.max(-1, Math.min(1, pitch / 25))
        : 0;

      const laneDirection = Math.abs(roll) < 7 ? 0 : Math.sign(roll);
      if (laneDirection === 0) {
        gyroLaneDirection = 0;
      } else if (laneDirection !== gyroLaneDirection) {
        move(laneDirection);
        gyroLaneDirection = laneDirection;
      }
    });

    window.addEventListener("devicemotion", (event) => {
      const acceleration = event.accelerationIncludingGravity;
      if (!acceleration) return;

      const strength = Math.sqrt(
        (acceleration.x || 0) ** 2 +
        (acceleration.y || 0) ** 2 +
        (acceleration.z || 0) ** 2
      );
      const now = Date.now();
      if (strength > 24 && now - lastShakeTime > 1000) {
        lastShakeTime = now;
        toggleEasterEggByShake();
      }
    });

    stage.addEventListener("touchstart", (event) => {
      touchStartX = event.changedTouches[0].clientX;
    }, { passive: true });

    stage.addEventListener("touchend", (event) => {
      if (touchStartX === null) return;
      const distance = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(distance) > 28) move(distance > 0 ? 1 : -1);
      touchStartX = null;
    }, { passive: true });

    document.getElementById("startButton").addEventListener("click", async () => {
      const sensors = [window.DeviceMotionEvent, window.DeviceOrientationEvent];
      const permissionRequests = sensors
        .filter((sensor) => typeof sensor?.requestPermission === "function")
        .map((sensor) => sensor.requestPermission());

      for (const request of permissionRequests) {
        try {
          const permission = await request;
          if (permission !== "granted") console.warn("Motion sensor permission was not granted.");
        } catch (error) {
          console.warn("Could not request motion sensor permission.", error);
        }
      }
    });

    loadProfile();
    drawRoad();
    drawCar(laneX(lane, playerY), playerY, playerColor, true);
  })();
</script>
